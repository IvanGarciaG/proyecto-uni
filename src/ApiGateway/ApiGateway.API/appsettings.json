{
  "Auth": {
    "Authority": "http://identity:5000",
    "Audience": "microservices"
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "users-register-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/register" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": { "Path": "/api/files/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "location-route": {
        "ClusterId": "location-cluster",
        "Match": { "Path": "/api/location/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "geocoding-route": {
        "ClusterId": "geocoding-cluster",
        "Match": { "Path": "/api/geocoding/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users/destination1": { "Address": "http://users-service:8080" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders/destination1": { "Address": "http://orders-service:8080" }
        }
      },
      "products-cluster": {
        "Destinations": {
          "products/destination1": { "Address": "http://products-service:8080" }
        }
      },
      "files-cluster": {
        "Destinations": {
          "files/destination1": { "Address": "http://files-service:8080" }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity/destination1": { "Address": "http://identity-service:8080" }
        }
      },
      "location-cluster": {
        "Destinations": {
          "location/destination1": { "Address": "http://location-service:8080" }
        }
      },
      "geocoding-cluster": {
        "Destinations": {
          "geocoding/destination1": { "Address": "http://geocoding-service:8080" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications/destination1": { "Address": "http://notifications-service:8080" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341" } }
    ]
  }
}
