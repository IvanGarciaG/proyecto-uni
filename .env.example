# Google OAuth2 — obtener en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Google Maps API — obtener en https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# JWT — genera con: openssl rand -base64 64
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_muy_larga_de_al_menos_64_caracteres

# Mailtrap — obtener en https://mailtrap.io/ → Email Testing → Inboxes → SMTP Settings
MAILTRAP_USER=tu-mailtrap-user
MAILTRAP_PASSWORD=tu-mailtrap-password
